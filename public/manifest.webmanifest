{
    "name": "Personal Hub",
    "short_name": "Hub",
    "description": "Persönlicher Organisations-Leitstand",
    "lang": "de",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#f4f5f7",
    "theme_color": "#16181d",
    "icons": [
        { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
    ],
    "shortcuts": [
        { "name": "Erfassen", "short_name": "Erfassen", "url": "/erfassen", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Inbox", "short_name": "Inbox", "url": "/inbox", "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }] }
    ],
    "share_target": {
        "action": "/erfassen",
        "method": "GET",
        "params": { "title": "title", "text": "text", "url": "url" }
    }
}
