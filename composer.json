{
    "name": "bezugsraum/personal-hub",
    "description": "Persönliches, selbst gehostetes Organisationstool für eine Person.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "sabre/vobject": "^5.0",
        "league/commonmark": "^2.10",
        "minishlink/web-push": "^11.0",
        "spomky-labs/otphp": "^11.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix --dry-run --diff"
    }
}
